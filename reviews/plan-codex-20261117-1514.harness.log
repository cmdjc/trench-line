  S.t+=dt;S.supplies+=incomeNow()*dt;
  if(SUPER>0&&owner[SUPER]===0){S.superT+=dt;if(S.superT>=SUPER_CARD_T){S.superT-=SUPER_CARD_T;S.pending++;toast('The super trench has sent you a free card.')}}
  stepUnits(dt);aiStep(dt);stepSW(dt);
  for(const a of [tracers,booms,floats])for(const o of a)o.life-=dt;
  tracers=tracers.filter(o=>o.life>0);booms=booms.filter(o=>o.life>0);floats=floats.filter(o=>o.life>0);
  for(const f of floats)f.y-=dt*22;
  for(const p of smoke){p.life-=dt;p.r+=dt*(p.dark?7:5);p.y-=dt*9;p.x-=dt*4}
  smoke=smoke.filter(p=>p.life>0);
  for(const w of wrecks){w.t+=dt;if(w.t<18){w.puff-=dt;if(w.puff<=0){w.puff=0.22;puff(w.x+(Math.random()-0.5)*14,w.y+(Math.random()-0.5)*8,true)}}}
  const fl=frontLine();if(sel>Math.max(fl,0)&&countAt(0,sel)===0)sel=fl;
  if(sel>0&&sel<HQI){
    let foes=0,near=0;const sx=LX[sel];
    for(const u of units){if(u.fixed)continue;if(u.side===1){if(u.line===sel&&u.settled)foes++}else if(Math.abs(u.x-sx)<260&&u.line>=sel)near++}
    if(foes&&!near){for(const u of units)if(u.side===0&&u.line===sel&&!u.fixed)u.line=sel-1;toast('Trench '+sel+' is lost. Your orders fall back to '+lineName(sel-1)+'.');sel--}
  }
  if(bases[1].hp<=0)endGame(true);else if(bases[0].hp<=0)endGame(false);
  else if(S.pending>0&&$('cardOv').hidden)offerCards();
}

