    let r=Math.random()*tot,i=0;for(;i<pool.length-1;i++){r-=pool[i].w;if(r<=0)break}
    out.push(pool.splice(i,1)[0]);
  }
  $('cardSub').textContent=S.pending>1?'It lasts for the rest of this battle. '+(S.pending-1)+' more to choose after this.':'It lasts for the rest of this battle.';
  $('cardList').innerHTML=out.map(c=>'<button class="pick" data-card="'+c.id+'"><h3>'+c.name+'</h3><p>'+c.text+'</p></button>').join('');
