/* ---------- geometry ---------- */
const trenchX=(cx,y)=>cx+((Math.floor(y/SEG)%2)?6:-6);
function posX(side,L,y,tank){
  const dir=side?-1:1,own=side?HQI:0,foe=HQI-own;
  if(L===own)return LX[own]+dir*(tank?52+Math.abs(tank):55);
  if(L===foe)return LX[foe]-dir*(tank?72+Math.abs(tank):85);
  return tank?LX[L]+dir*tank:trenchX(LX[L]+(isDbl(L)?((Math.floor(y*0.61)%2)?14:-14):0),y);
}
const isTrench=L=>L>=1&&L<=NT;
function pickLane(side,L){
  let best=150,bs=-1;
  for(let k=0;k<5;k++){
    const y=22+Math.random()*(WH-44);let near=1e9;
    for(const u of units)if(u.side===side&&u.line===L)near=Math.min(near,Math.abs(u.y-y));
    if(near>bs){bs=near;best=y}
  }
  return best;
}
/* on maps with a railhead, reinforcements appear one trench behind the line they are sent to */
function startX(side,L){
  const dir=side?-1:1,own=side?HQI:0;
  if(!MAPS[MAP].rail)return LX[own]-dir*14;
  return LX[Math.max(0,Math.min(HQI,L-dir))]-dir*14;
}
