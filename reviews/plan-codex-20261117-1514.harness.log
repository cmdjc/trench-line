const META_KEY='trenchline-meta';
let META={points:0,tech:{},runs:0,wins:0};
const store=(typeof window.storage!=='undefined'&&window.storage&&window.storage.set)?window.storage:null;
/* two automatic saves: each holds the save code, a counter and a time; the newest valid one wins */
const SAVE_KEYS=[META_KEY,META_KEY+'-b'];
let saveOk=-1;
function parseSave(text){
  try{
    const d=JSON.parse(text);
    if(d&&typeof d.code==='string'){const data=readCode(d.code);return data?{data,rev:d.rev||0,ts:d.ts||0}:null}
    if(d&&typeof d.points==='number')return {data:{points:d.points,tech:Object.assign({},d.tech||{}),runs:d.runs||0,wins:d.wins||0},rev:0,ts:0};
  }catch(e){}
  return null;
}
async function loadMeta(){
  if(!store){saveState();return}
  const found=[];
  for(const k of SAVE_KEYS){
    let rec=null;
    try{const r=await store.get(k,false);if(r&&r.value)rec=parseSave(r.value)}catch(e){}
    found.push(rec);
  }
  const good=found.filter(Boolean).sort((x,y)=>(y.rev-x.rev)||(y.ts-x.ts));
  if(good.length){
    const g=good[0];
    META.points=g.data.points;META.tech=g.data.tech;META.runs=g.data.runs;META.wins=g.data.wins;META.rev=g.rev;
    if(found.some(f=>!f||f.rev!==g.rev))await saveMeta();else{saveOk=2;saveState()}
  }else saveState();
}
async function saveMeta(){
  if(!store){saveState();return}
  META.rev=(META.rev||0)+1;
  const rec=JSON.stringify({code:makeCode(),rev:META.rev,ts:Date.now()});
  let ok=0;
  for(const k of SAVE_KEYS){try{const r=await store.set(k,rec,false);if(r!==null)ok++}catch(e){}}
  saveOk=ok;saveState();
}
function saveState(){
  const el=document.getElementById('saveState');if(!el)return;
  el.textContent=!store?'Automatic saving is not available here, so your code is the only save.'
    :saveOk===2?'Saved automatically in two places.'
    :saveOk===1?'One of the two automatic saves failed. The other is good, and your code still works.'
    :saveOk===0?'Both automatic saves failed. Copy your code to keep your progress.'
    :'Two automatic saves are kept. Nothing to save yet.';
}
const has=id=>!!META.tech[id];
/* save code: TL1-points-upgrades-runs-wins-check, all in base 36 */
const TECH_IDS=()=>TECH.flatMap(b=>b.nodes.map(n=>n.id));
function codeCheck(body){let h=7;for(let i=0;i<body.length;i++)h=(h*31+body.charCodeAt(i))%1296;return h.toString(36).toUpperCase().padStart(2,'0')}
function makeCode(){
  let mask=0;TECH_IDS().forEach((id,i)=>{if(META.tech[id])mask|=1<<i});
  const body=['TL1',META.points,mask,META.runs,META.wins].map((v,i)=>i?Math.max(0,Math.floor(v)).toString(36).toUpperCase():v).join('-');
  return body+'-'+codeCheck(body);
}
function readCode(text){
  const parts=text.trim().toUpperCase().replace(/\s+/g,'').split('-');
  if(parts.length!==6||parts[0]!=='TL1')return null;
  const body=parts.slice(0,5).join('-');
  if(codeCheck(body)!==parts[5])return null;
  const nums=parts.slice(1,5).map(v=>parseInt(v,36));
  if(nums.some(v=>!isFinite(v)||v<0))return null;
  const tech={};TECH_IDS().forEach((id,i)=>{if(nums[1]&(1<<i))tech[id]=1});
  for(const b of TECH)b.nodes.forEach((n,i)=>{if(tech[n.id]&&i>0&&!tech[b.nodes[i-1].id])delete tech[n.id]});
  return {points:nums[0],tech,runs:nums[2],wins:nums[3]};
}
function applyTech(){
  const m=M[0];
  if(has('marks'))m.dmg.rifle*=1.1;
  if(has('kit'))m.hp*=1.1;
  if(has('craft'))m.speed*=1.15;
  if(has('deep'))m.cover*=0.92;
  if(has('walls')){bases[0].max+=400;bases[0].hp+=400}
  if(has('guns'))bases[0].dmg*=1.4;
  if(has('aid'))m.heal+=1;
  if(has('stock'))S.supplies+=40;
  if(has('rail'))m.income+=0.4;
  if(has('econ'))m.bounty+=0.2;
  if(has('mech'))m.tankHp*=1.1;
  if(has('gunnery')){for(const k of TK)m.dmg[k]*=1.1;m.dmg.mortar*=1.1}
  if(has('works'))for(const k of TK)m.cost[k]*=0.9;
  if(has('titan'))S.unlocked.tkS=true;
}

