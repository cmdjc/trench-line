cv.addEventListener('pointerdown',ev=>{drag={x:ev.clientX,cam,moved:false};try{cv.setPointerCapture(ev.pointerId)}catch(e){}});
cv.addEventListener('pointermove',ev=>{
  if(!drag)return;const dx=ev.clientX-drag.x;
  if(Math.abs(dx)>6)drag.moved=true;
  if(drag.moved){cam=camT=Math.max(0,Math.min(WW-vw(),drag.cam-dx/K))}
});
function endDrag(ev){
  if(!drag)return;
  if(!drag.moved&&ev.type==='pointerup'){
    const r=cv.getBoundingClientRect(),wx=cam+(ev.clientX-r.left)/K;
    if(aim){aim.x=Math.max(0,Math.min(WW,wx));aim.y=Math.max(0,Math.min(WH,(ev.clientY-r.top)/K));refresh();drag=null;return}
    let best=-1,bd=70;for(let L=0;L<=HQI;L++){const d=Math.abs(posX(0,L,150,false)-wx);if(d<bd){bd=d;best=L}}
    if(best>=0){
      const now=performance.now();
      if(lastTap.L===best&&now-lastTap.t<420){fortify(best);lastTap.t=0}
      else{select(best,false);lastTap={L:best,t:now}}
    }
  }
  drag=null;
}
cv.addEventListener('pointerup',endDrag);cv.addEventListener('pointercancel',endDrag);
cv.addEventListener('keydown',ev=>{
  if(ev.key==='ArrowRight'){camT=Math.min(WW-vw(),camT+120);ev.preventDefault()}
  else if(ev.key==='ArrowLeft'){camT=Math.max(0,camT-120);ev.preventDefault()}
});
