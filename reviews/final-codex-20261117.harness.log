    const g=c*0.25*M[0].bounty;
    S.kills++;S.score+=Math.min(3,c/20);S.cardKills+=Math.min(3,c/20);S.supplies+=g;
    floats.push({x:e.x,y:e.y-8,txt:'+'+Math.round(g),life:1});if(floats.length>30)floats.shift();
    if(S.cardKills>=S.need){S.cardKills-=S.need;S.need+=3;S.pending++}
  }else{S.losses++;ai.money+=c*0.25}
  if(e.T.armor){boom(e.x,e.y,e.T.big?44:24);wrecks.push({x:e.x,y:e.y,side:e.side,nat:e.type==='tsar'?'tsar':nation[e.side]==='ru'?'fr':nation[e.side],t:0,puff:0,d:e.T.draw?{L:e.T.draw.L,W:e.T.draw.W}:null});if(wrecks.length>10)wrecks.shift()}
  scorch.push({x:e.x,y:e.y,r:e.T.big?40:e.T.armor?20:4.5});if(scorch.length>70)scorch.shift();
}
