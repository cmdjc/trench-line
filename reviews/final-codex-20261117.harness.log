    }
  }
  for (const u of G.units) {
    if (!u.T.armor && vis(u.x) && !(u.shelter && u.shelter.hp > 0 && u.settled)) at(u.x, u.y, u.side === 1, () => drawSoldier(u));
  }
  drawSmoke(vis);
  drawShells(vis);
  drawPlanes(vis);
  drawWarnings(vis);
  drawAim();
  drawTracers(vis);
  drawBooms(vis);
  drawFloats(vis);
  ctx.restore();
}
