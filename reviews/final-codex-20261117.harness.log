// Seeded random source for the whole simulation. Battles are reproducible:
// newGame(mine, theirs, map, seed) reseeds this generator, and every
// Math.random() in the prototype's simulation now goes through rng.
//
// mulberry32: small, fast, good enough distribution for gameplay.

/** @param {number} seed uint32 */
export function makeRng(seed) {
  let a = seed >>> 0;
  return () => {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function defaultSeed() {
  return (Date.now() ^ (Math.random() * 0xFFFFFFFF)) >>> 0;
}

export const rng = {
  seed: 0,
  /** @param {number} [n] */
  reseed(n = defaultSeed()) {
    this.seed = n >>> 0;
    this._next = makeRng(this.seed);
    return this.seed;
  },
  _next: makeRng(1),
  float() { return this._next(); },
  range(a, b) { return a + (b - a) * this._next(); },
  int(n) { return Math.floor(this._next() * n); },
  pick(arr) { return arr[Math.floor(this._next() * arr.length)]; },
};
rng.reseed();

// Map-decoration generator, ported verbatim from the prototype (rnd at line
// 1578): a Lehmer/Park–Miller style generator used with fixed seeds so ground
// patches and craters are stable for a given map.
export function decor(seed) {
  let s = seed;
  return () => {
    s = (s * 16807) % 2147483647;
    return (s - 1) / 2147483646;
  };
}
function newGame(mine,theirs,map){
  nation=[mine,theirs];MAP=MAPS[map]?map:'open';setLayout(MAP);RIV=MAPS[MAP].rivers;
  S={t:0,score:0,supplies:mine==='aq'?15:40,kills:0,losses:0,cardKills:0,need:4,pending:0,taken:{},cards:0,unlocked:{rifle:true,mg:true},barrageT:6,warnT:0,superOwner:-1,superCard:false,superT:0};
  sw=[{cd:0,tunnel:null},{cd:0,tunnel:null}];
  M=[mods(),mods()];
  for(let s=0;s<2;s++){if(nation[s]==='gb')M[s].cd.rifle=0.85;if(nation[s]==='it')M[s].cover*=0.85}
  if(nation[0]==='us'){M[0].income=2.3;M[0].growth=0.4}
  if(nation[0]==='aq'){M[0].income=2;M[0].growth=0.7}
  relabelCards();
  units=[];aim=null;planes=[];tracers=[];shells=[];booms=[];floats=[];scorch=[];smoke=[];wrecks=[];
  bases=[{x:LX[0],hp:BASE_HP,max:BASE_HP,cd:0,dmg:1},{x:LX[HQI],hp:BASE_HP,max:BASE_HP,cd:0,dmg:1}];
  ai={money:40,buyT:1,thinkT:3,lastAdv:0,aggr:2,want:null,F:NT};
