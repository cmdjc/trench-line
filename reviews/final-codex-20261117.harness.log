import { G, isDbl, toast } from './state.js';
import { isTrench, posX } from './geometry.js';
import { stepFields, stepBunkers, stepJobs, wireSlow, buildSuper } from './fortify.js';
import { rng } from '../core/rng.js';

export function hurt(e, dmg, atk, attacker, cov, area) {
  if (e.hp <= 0) return;
  /* troops sheltering in a bunker can't be hurt until it falls: direct fire hits the bunker instead, and splash only reaches the bunker itself */
  if (e.shelter && e.shelter.hp > 0 && e.settled) { if (!area) hurt(e.shelter, dmg, atk, attacker, cov); return; }
  let mult = 1;
  if (e.T.nest) mult = (e.T.ncov || NESTCOV)[atk];
  else if (e.T.soft) mult = 0.6;
  else if (e.T.armor) mult = ARM[atk] * (e.T.thin && ARM[atk] < 0.5 ? 2 : 1);
  else if (e.settled) {
    if (isTrench(e.line)) { if (atk !== 'raider' && !(attacker && attacker.settled && attacker.line === e.line)) mult = (cov || COV[atk]) * G.M[e.side].cover * FORTD[G.fort[e.line]] * (isDbl(e.line) ? 0.55 : 1); }
    else if (e.line === (e.side ? G.HQI : 0)) mult = 0.5;
  }
  if (e.T.shield && (atk === 'rifle' || atk === 'mg' || atk === 'sniper' || atk === 'base')) mult *= e.T.shield;
  e.hp -= dmg * mult;
  if (e.hp <= 0) die(e);
}

/* static stand-in used when a base fires: it is nobody's unit */
export const HQG = { type: 'base', settled: false, line: -1 };

/* fortified trenches are harder to hit */
export function accVs(u, e) {
  return (e.settled && !e.T.armor && !e.T.nest && isTrench(e.line) && G.fort[e.line] && u.type !== 'raider' && !(u.settled && u.line === e.line)) ? FORTA[G.fort[e.line]] : 1;
}

export function die(e) {
  const c = e.T.cost;
  if (e.side === 1) {
    const g = c * 0.25 * G.M[0].bounty;
    G.S.kills++; G.S.score += Math.min(3, c / 20); G.S.cardKills += Math.min(3, c / 20); G.S.supplies += g;
    G.floats.push({ x: e.x, y: e.y - 8, txt: '+' + Math.round(g), life: 1 }); if (G.floats.length > 30) G.floats.shift();
    if (G.S.cardKills >= G.S.need) { G.S.cardKills -= G.S.need; G.S.need += 3; G.S.pending++; }
  } else { G.S.losses++; G.ai.money += c * 0.25; }
  if (e.T.armor) {
    boom(e.x, e.y, e.T.big ? 44 : 24);
    G.wrecks.push({ x: e.x, y: e.y, side: e.side, nat: e.type === 'tsar' ? 'tsar' : G.nation[e.side] === 'ru' ? 'fr' : G.nation[e.side], t: 0, puff: 0, d: e.T.draw ? { L: e.T.draw.L, W: e.T.draw.W } : null });
    if (G.wrecks.length > 10) G.wrecks.shift();
  }
  G.scorch.push({ x: e.x, y: e.y, r: e.T.big ? 40 : e.T.armor ? 20 : 4.5 }); if (G.scorch.length > 70) G.scorch.shift();
}

export function hurtBase(side, dmg) {
  const b = G.bases[side]; b.hp = Math.max(0, b.hp - dmg);
  if (side === 0 && G.S.t > G.S.warnT) { G.S.warnT = G.S.t + 12; toast('Your HQ is under fire.'); }
}

export function puff(x, y, dark) { G.smoke.push({ x, y, r: dark ? 3 : 2, life: dark ? 1.6 : 1.1, max: dark ? 1.6 : 1.1, dark }); if (G.smoke.length > 160) G.smoke.shift(); }
export function boom(x, y, r) { G.booms.push({ x, y, r, life: 0.45, max: 0.45 }); if (G.booms.length > 30) G.booms.shift(); }
export function tracer(x1, y1, x2, y2, w, col) { G.tracers.push({ x1, y1, x2, y2, w, col, life: 0.08 }); if (G.tracers.length > 90) G.tracers.shift(); }

export function stepUnits(dt) {
  for (const u of G.units) {
    if (u.hp <= 0) continue;
    const T = u.T, m = G.M[u.side], minR = T.min || 0;
    let best = null, bd = 1e9, blocked = false;
    for (const e of G.units) {
      if (e.side === u.side || e.hp <= 0) continue;
      const dx = e.x - u.x, d = Math.hypot(dx, e.y - u.y);
      if (d < bd && d >= minR) { bd = d; best = e; }
      if (Math.abs(dx) < 40 && !(e.settled && e.line === u.line)) blocked = true;
      if (T.crush && d < T.crush) hurt(e, T.crushDps * dt, 'raider', null, undefined, true);
    }
    if (T.crush) blocked = false;
    if (u.ly === undefined) u.ly = u.y;
    const tx = u.tx !== undefined ? u.tx : posX(u.side, u.line, u.ly, u.park), dx = tx - u.x, sgn = Math.sign(dx);
    let ty = u.ly, limX = null;
    if (G.RIV.length && !T.big) {
      for (let i = 0; i < G.RIV.length; i++) {
        const r = G.RIV[sgn < 0 ? G.RIV.length - 1 - i : i];
        const inside = u.x > r.x0 - 3 && u.x < r.x1 + 3;
        const ahead = sgn > 0 ? (u.x <= r.x0 - 3 && tx > r.x0) : sgn < 0 ? (u.x >= r.x1 + 3 && tx < r.x1) : false;
        if (!inside && !ahead) continue;
        let by = r.b[0]; for (const b of r.b) if (Math.abs(b - u.y) < Math.abs(by - u.y)) by = b;
        const band = Math.max(by - BW, Math.min(by + BW, u.y));
        if (inside) ty = band;
        else {
          const gap = sgn > 0 ? r.x0 - u.x : u.x - r.x1;
          if (gap < 170) ty = band;
          if (Math.abs(u.y - band) > 1.2) limX = sgn > 0 ? r.x0 - 7 : r.x1 + 7;
        }
        break;
      }
    }
    const dy = ty - u.y;
    if ((Math.abs(dx) > 1.5 || Math.abs(dy) > 1.5) && !blocked) {
      const sp = T.speed * (T.armor ? 1 : m.speed) * dt * wireSlow(u);
      let nx = u.x + sgn * Math.min(sp, Math.abs(dx));
      if (limX !== null) nx = sgn > 0 ? Math.min(nx, Math.max(u.x, limX)) : Math.max(nx, Math.min(u.x, limX));
      /* hedgehogs: an enemy-held double trench stops tanks short of its belt (giants roll over) */
      if (T.armor && !T.big && sgn) for (const L of G.DBL) {
        if (G.owner[L] !== 1 - u.side) continue;
        const stop = G.LX[L] - sgn * (HEDGE + (T.len || 21) + 8);
        if (sgn > 0 ? (u.x <= stop + 0.5 && tx > stop) : (u.x >= stop - 0.5 && tx < stop)) {
          const c = sgn > 0 ? Math.min(nx, stop) : Math.max(nx, stop);
          if (c !== nx && u.side === 0 && G.S.t > (G.S.hhT || 0)) { G.S.hhT = G.S.t + 25; toast('Hedgehogs are holding your tanks at super trench ' + L + '. They can pass once your infantry take it.'); }
          nx = c;
        }
      }
      const still = Math.abs(nx - u.x) < 0.001 && Math.abs(dy) <= 1.5;
      u.tread += Math.abs(nx - u.x) * (sgn === (u.side ? -1 : 1) ? 1 : -1);
      u.x = nx; u.y += Math.max(-sp, Math.min(sp, dy));
      u.settled = false; u.moving = !still; if (!still) u.walk += dt * 10;
    } else {
      u.moving = false;
      if (Math.abs(dx) <= 1.5 && Math.abs(dy) <= 1.5) { u.x = tx; u.settled = true; }
    }
    if (u.settled && m.heal && isTrench(u.line) && u.hp < u.max) u.hp = Math.min(u.max, u.hp + m.heal * dt);
    u.cd -= dt; u.flash -= dt;
    const dir = u.side ? -1 : 1;
    if (T.armor) {
      u.puff -= dt;
      if (u.puff <= 0 && !T.soft) {
        const hurtBad = u.hp < u.max * 0.33;
        u.puff = hurtBad ? 0.1 : u.moving ? 0.16 : 0.5;
        puff(u.x - dir * (hurtBad ? 4 : (T.len || 21)) + (rng.float() - 0.5) * 4, u.y + (rng.float() - 0.5) * 8, hurtBad);
      }
      if (T.mg) {
        u.cd2 -= dt; u.flash2 -= dt;
        if (u.cd2 <= 0 && best && bd <= T.mg.range) {
          u.cd2 = T.mg.cd * (0.8 + rng.float() * 0.4); u.flash2 = 0.07;
          const sy = best.y < u.y ? -(T.big ? 20 : 13) : (T.big ? 20 : 13);
          if (rng.float() < T.mg.acc * accVs(u, best)) { tracer(u.x, u.y + sy, best.x, best.y, 1, '#ffd76a'); hurt(best, T.mg.dmg, 'mg', u); }
          else tracer(u.x, u.y + sy, best.x + (rng.float() - 0.5) * 30, best.y + (rng.float() - 0.5) * 30, 0.8, 'rgba(255,215,106,.6)');
        }
      }
    }
    if (u.cd > 0 || T.noFire || (u.moving && !T.moveFire)) continue;
    const dmg = T.dmg * m.dmg[u.type];
    let ox = u.x, oy = u.y;
    if (T.armor) {
      const hit = best && bd <= T.range, gx = hit ? best.x : G.bases[1 - u.side].x, gy = hit ? best.y : WH / 2;
      u.gun = -u.gun;
      if (T.turret) { u.aim = Math.atan2(gy - u.y, (gx - u.x) * dir); ox = u.x + dir * (T.turret.x + Math.cos(u.aim) * T.turret.len); oy = u.y + Math.sin(u.aim) * T.turret.len; }
      else if (T.spons) { ox = u.x + dir * T.spons[0]; oy = u.y + u.gun * T.spons[1]; }
      else ox = u.x + dir * 31;
    }
    if (best && bd <= T.range) {
      u.cd = T.cd * m.cd[u.type] * (0.85 + rng.range(0, 0.3)); u.flash = 0.08;
      if (T.shell) G.shells.push({ x0: ox, y0: oy, x1: best.x, y1: best.y, t: 0, dur: T.shell, side: u.side, type: T.atk || u.type, dmg, splash: T.splash, cov: T.cov, siege: T.siege, arc: T.arc || (u.type === 'mortar' && !T.flat ? 1 : 0.1) });
      else if (rng.float() < T.acc * accVs(u, best)) { tracer(u.x + dir * 9, u.y, best.x, best.y, u.type === 'sniper' ? 1.4 : 1, '#ffe9a8'); hurt(best, dmg, T.atk || u.type, u); }
      else tracer(u.x + dir * 9, u.y, best.x + (rng.float() - 0.5) * 30, best.y + (rng.float() - 0.5) * 30, 0.8, 'rgba(255,233,168,.6)');
      if (T.jam && rng.float() < T.jam) u.cd = 2.4;
      if (T.mag) { u.shots = (u.shots || 0) + 1; if (u.shots >= T.mag) { u.shots = 0; u.cd = T.reload; } }
    } else {
      const b = G.bases[1 - u.side], d = Math.abs(b.x - u.x);
      if (d <= T.range && d >= minR) {
        u.cd = T.cd * m.cd[u.type] * (0.85 + rng.range(0, 0.3)); u.flash = 0.08;
        const by = WH / 2 + (rng.float() - 0.5) * 70;
        if (T.shell) G.shells.push({ x0: ox, y0: oy, x1: b.x - dir * 20, y1: by, t: 0, dur: T.shell, side: u.side, type: T.atk || u.type, dmg: dmg * 1.5, base: true, siege: T.siege, arc: T.arc || (u.type === 'mortar' && !T.flat ? 1 : 0.1) });
        else { tracer(u.x + dir * 9, u.y, b.x - dir * 25, by, 1, '#ffe9a8'); hurtBase(1 - u.side, dmg * (u.type !== 'raider' && d > 120 ? 0.25 : 1)); }
      }
    }
  }
  // HQ guns
  for (let s = 0; s < 2; s++) {
    const b = G.bases[s]; b.cd -= dt; if (b.cd > 0 || b.hp <= 0) continue;
    let best = null, bd = 270;
    for (const e of G.units) { if (e.side === s || e.hp <= 0) continue; const d = Math.abs(e.x - b.x); if (d < bd) { bd = d; best = e; } }
    if (best) {
      b.cd = 0.25; const dir = s ? -1 : 1;
      if (rng.float() < 0.55 * accVs(HQG, best)) { tracer(b.x + dir * 22, WH / 2 + (rng.float() - 0.5) * 50, best.x, best.y, 1, '#ffd76a'); hurt(best, 9 * b.dmg, 'base', null); }
    }
  }
  // shells
  for (const s of G.shells) {
    s.t += dt; if (s.t < s.dur) continue;
    if (s.huge) {
      for (let i = 0; i < 9; i++) { const a = i * 0.7 + rng.float(), r = i ? rng.float() * s.splash * 0.8 : 0; boom(s.x1 + Math.cos(a) * r, s.y1 + Math.sin(a) * r, 34 + rng.float() * 26); }
      if (!G.reduceMotion) G.shake = Math.max(G.shake, 10);
      G.scorch.push({ x: s.x1, y: s.y1, r: s.splash * 0.7 }); if (G.scorch.length > 70) G.scorch.shift();
      for (let L = 1; L <= G.NT; L++) if (Math.abs(s.x1 - G.LX[L]) < s.rz && G.owner[L] !== s.side) {
        if (G.fort[L] > 0 && s.side === 1) toast('The Paris Gun has levelled the fortifications at trench ' + L + '.');
        G.fort[L] = 0; G.fields = G.fields.filter(f => f.side === s.side || f.line !== L);
      }
      for (const e of G.units) {
        if (e.side === s.side || e.hp <= 0) continue;
        const d = Math.hypot(e.x - s.x1, e.y - s.y1); if (d > s.splash) continue;
        hurt(e, s.dmg * (1 - 0.55 * d / s.splash), 'barrage', null, s.cov, true);
      }
      const hb = G.bases[1 - s.side], hd = Math.hypot(hb.x - s.x1, WH / 2 - s.y1);
      if (hd <= s.splash + 22) hurtBase(1 - s.side, s.dmg * 0.8 * (1 - 0.4 * hd / (s.splash + 22)));
      continue;
    }
    boom(s.x1, s.y1, s.big ? 46 : s.base ? 16 : Math.max(10, (s.splash || 20) * 0.6));
    if (s.big && !G.reduceMotion) G.shake = Math.max(G.shake, 4);
    if (s.raze && !s.base) for (let L = 1; L <= G.NT; L++) if (Math.abs(s.x1 - G.LX[L]) < 32 && G.owner[L] !== s.side) { G.fort[L] = 0; G.fields = G.fields.filter(f => f.side === s.side || f.line !== L); }
    for (const f of G.fields) if (f.type === 'wire' && Math.abs(s.x1 - f.x) < f.w / 2 + 12) f.hp -= s.dmg;
    if (s.siege && !s.base) for (let L = 1; L <= G.NT; L++) if (Math.abs(s.x1 - G.LX[L]) < 26 && G.fort[L] > 0 && rng.float() < 0.4) {
      G.fort[L]--; boom(s.x1, s.y1, 46);
      if (G.owner[L] === 0) toast('A siege shell smashed part of the fortifications at trench ' + L + '.');
    }
    if (s.base) hurtBase(1 - s.side, s.dmg);
    else for (const e of G.units) { if (e.side === s.side || e.hp <= 0) continue; if (Math.hypot(e.x - s.x1, e.y - s.y1) <= s.splash) hurt(e, s.dmg, s.type, null, s.cov, true); }
  }
  G.shells = G.shells.filter(s => s.t < s.dur);
  // card barrage
  if (G.M[0].barrage) {
    G.S.barrageT -= dt;
    if (G.S.barrageT <= 0) {
      G.S.barrageT = 10;
      let tgt = null; for (const e of G.units) if (e.side === 1 && e.hp > 0 && e.settled && (!tgt || e.x < tgt.x)) tgt = e;
      if (tgt) for (let i = 0; i < G.M[0].barrage; i++) G.shells.push({ x0: G.bases[0].x, y0: WH / 2, x1: tgt.x + (rng.float() - 0.5) * 26, y1: 20 + rng.float() * (WH - 40), t: -i * 0.25, dur: 1.6, side: 0, type: 'barrage', dmg: 26, splash: 36, arc: 1.5 });
    }
  }
  stepFields();
  G.units = G.units.filter(u => u.hp > 0);
  // who holds what
  for (let L = 1; L <= G.NT; L++) {
    let a = 0, b = 0; for (const u of G.units) if (u.line === L && u.settled && !u.fixed) { if (u.side) b++; else a++; }
    if (a && !b) G.owner[L] = 0; else if (b && !a) G.owner[L] = 1;
  }
  if (G.SUPER > 0 && G.owner[G.SUPER] !== G.S.superOwner) {
    const prev = G.S.superOwner, now = G.owner[G.SUPER]; G.S.superOwner = now;
    if (now >= 0) {
      if (prev < 0) buildSuper(now);
      if (now === 0) {
        toast('You hold the super trench. Its guns are yours, it pays +' + SUPER_INC + ' supplies a second, and it sends a free card every 3 minutes.' + (G.S.superCard ? '' : ' The first one is yours now.'));
        if (!G.S.superCard) { G.S.superCard = true; G.S.pending++; }
      } else toast('The enemy has taken the super trench.');
    }
  }
  for (const n of G.units) {
    if (!n.T.nest) continue;
    let a = 0, b = 0; for (const u of G.units) if (!u.fixed && u.line === n.line && u.settled) { if (u.side === n.side) a++; else b++; }
    if (b && !a) { n.side = 1 - n.side; n.hp = Math.max(n.hp, n.max * 0.5); n.cd = 1; toast(n.side === 0 ? 'You captured a ' + n.T.name + ' at trench ' + n.line + '.' : 'The enemy captured your ' + n.T.name + ' at trench ' + n.line + '.'); }
  }
  for (let sd = 0; sd < 2; sd++) {
    if (G.nation[sd] !== 'ah') continue;
    for (let L = 1; L <= G.NT; L++) {
      if (G.fort[L] >= maxFort(L)) { G.garr[L] = 0; continue; }
      let n = 0; for (const u of G.units) if (u.side === sd && u.line === L && u.settled && !u.fixed && !u.T.armor) n++;
      if (n < 3) continue;
      G.garr[L] += dt;
      if (G.garr[L] >= GARR_T[G.fort[L]]) { G.garr[L] = 0; G.fort[L]++; if (sd === 0) toast('Your garrison has fortified trench ' + L + ' to level ' + G.fort[L] + '.'); }
    }
  }
  stepBunkers();
  stepJobs(dt);
}
// Enemy commander. Verbatim port of prototype lines 1197–1261; Math.random →
// seeded rng so every AI decision replays identically for a given seed.

import { NAT, AI_UNLOCK, AI_INCOME, AI_RAMP, AI_W } from '../data/nations.js';
import { SW } from '../data/superweapons.js';
import { ORDER, FORT_COST, maxFort, DEPOT_RATE, SUPER_INC, DBL_RATE } from '../data/units.js';
import { G, depots, dblHeld, nestCost, toast } from './state.js';
import { isTrench, ut, full, spawn, frontLine, power } from './geometry.js';
import { canDef, freeSlot, buildNest, buildDef } from './fortify.js';
import { swBlock, useSW } from './superweapons.js';
import { rng } from '../core/rng.js';

export function aiStep(dt) {
  const ai = G.ai;
  ai.money += (AI_INCOME * (1 + G.S.t / AI_RAMP) * (G.nation[1] === 'us' ? Math.min(1.8, 0.75 + G.S.t / 400) : G.nation[1] === 'aq' ? Math.min(2, 0.6 + G.S.t / 300) : 1) + depots(1) * DEPOT_RATE + (G.owner[G.SUPER] === 1 ? SUPER_INC : 0) + dblHeld(1) * DBL_RATE) * dt;
  ai.buyT -= dt;
  if (ai.buyT <= 0) {
    ai.buyT = 0.5;
    {
      const F = ai.F, canBuild = isTrench(F) && G.owner[F] === 1;
      if (!ai.want && G.S.t > 60 && canBuild && rng.float() < 0.05) {
        if (G.fort[F] < maxFort(F) && FORT_COST[G.fort[F]] <= ai.money * 2 + 80 && rng.float() < 0.5) ai.want = 'fort';
        else if (canDef(1, F) && rng.float() < 0.5) ai.want = 'def';
        else if (freeSlot(F) >= 0) ai.want = 'nest';
      }
      if (!ai.want && G.S.t > 240 && SW[G.nation[1]] && !swBlock(1) && (SW[G.nation[1]].cost < 1500 || ai.money >= SW[G.nation[1]].cost * 0.6) && rng.float() < 0.025) ai.want = 'sw';
      if (ai.want === 'sw') {
        const d = SW[G.nation[1]];
        if (swBlock(1)) ai.want = null;
        else if (ai.money >= d.cost) { if (useSW(1)) ai.money -= d.cost; ai.want = null; }
      } else if (ai.want === 'fort') {
        if (!canBuild || G.fort[F] >= maxFort(F)) ai.want = null;
        else if (ai.money >= FORT_COST[G.fort[F]]) { ai.money -= FORT_COST[G.fort[F]]; G.fort[F]++; ai.want = null; }
      } else if (ai.want === 'nest') {
        if (!canBuild || freeSlot(F) < 0) ai.want = null;
        else if (ai.money >= nestCost(1)) { ai.money -= nestCost(1); buildNest(1, F); ai.want = null; }
      } else if (ai.want === 'def') {
        const dc = NAT[G.nation[1]].def.cost;
        if (!canBuild || !canDef(1, F)) ai.want = null;
        else if (ai.money >= dc) { ai.money -= dc; buildDef(1, F); ai.want = null; }
      } else {
        if (!ai.want) {
          let tot = 0; const ok = ORDER.filter(k => ut(1, k) && G.S.t >= AI_UNLOCK[k] && !full(1, k) && ut(1, k).cost <= ai.money * 2 + 60);
          for (const k of ok) tot += AI_W[k];
          let r = rng.float() * tot; for (const k of ok) { r -= AI_W[k]; if (r <= 0) { ai.want = k; break; } }
        }
        if (!ai.want || full(1, ai.want)) ai.want = null;
        else if (ai.money >= ut(1, ai.want).cost) { ai.money -= ut(1, ai.want).cost; spawn(1, ai.want, aiLine()); ai.want = null; }
      }
    }
  }
  ai.thinkT -= dt;
  if (ai.thinkT <= 0) { ai.thinkT = 3; aiThink(); }
}

export function aiLine() { return G.ai.F; }

export function aiThink() {
  const ai = G.ai;
  const pf = frontLine();
  let held = 0, ps = 0; for (const u of G.units) if (u.line === ai.F && u.settled && !u.fixed) { if (u.side) held++; else ps++; }
  if (!held && G.S.t - ai.lastAdv > 12 && (ps > 0 || pf > ai.F)) ai.F = Math.min(G.HQI, pf + 1);
  const F = ai.F, us = G.units.filter(u => u.side === 1 && !u.fixed);
  for (const u of us) u.line = F;
  let engaged = 0; for (const u of G.units) if (u.side === 0 && u.line === F && Math.abs(u.x - G.LX[F]) < 260) engaged++;
  if (!us.length || F <= 0 || engaged > 0) return;
  let ready = 0, mine = 0;
  for (const u of us) { if (u.settled) ready++; mine += u.T.cost; }
  const T = F - 1, foe = power(0, T) + (T === 0 ? 140 : 0), beyond = T > 0 ? power(0, T - 1) : 0, since = G.S.t - ai.lastAdv;
  if (foe > 0 && F < G.HQI && since > 8 && mine < foe * 0.45) { ai.F = F + 1; for (const u of us) u.line = F + 1; ai.lastAdv = G.S.t; return; }
  if (ready < us.length * 0.7) return;
  let go;
  if (foe > 0) go = mine > foe * Math.max(1, ai.aggr - G.S.t / 300) && since > 15;
  else if (beyond > 0) go = mine >= beyond * 0.8 && since > 20;
  else go = mine >= 80 && since > 10;
  if (!go) return;
  ai.F = T; for (const u of us) u.line = T;
  ai.lastAdv = G.S.t; ai.aggr = 2 + rng.float() * 0.9;
  if (foe > 0) toast(T === 0 ? 'The enemy is storming your HQ.' : 'The enemy is attacking trench ' + T + '.');
}
// The simulation state container. Every piece of mutable state lives in the
// exported `G` object (the prototype's closure globals), so sim modules never
// hold their own copies. Port of prototype lines 234–241, 253, 623–639 (minus
// DOM), 653–693 (minus newGame/DOM). newGame arrives with geometry (Task 6).

import { MAPS } from '../data/maps.js';
import { NAT, AI_START } from '../data/nations.js';
import { CARDS, CARDTXT } from '../data/cards.js';
import { ORDER, TK, utOf, BASE_HP } from '../data/units.js';
import { DEPOT_RATE, DBL_RATE, SUPER_INC } from '../data/units.js';
import { rng } from '../core/rng.js';
import { bus } from '../core/events.js';
import { has } from './meta.js';
import { spawn, ut } from './geometry.js';

export const G = {
  /* layout (setLayout fills these in) */
  WW: 2600, NT: 9, HQI: 10, SUPER: -1, DBL: [],
  LX: (() => { const a = [150]; for (let i = 1; i <= 9; i++) a.push(150 + i * 230); a.push(2450); return a; })(),
  MAP: 'open', RIV: [],
  /* battle state (newGame builds these) */
  nation: ['gb', 'de'],
  S: null, M: null, units: null, bases: null, ai: null,
  sel: 1, owner: null,
  fort: new Array(11).fill(0), jobs: [], fields: [], garr: new Array(11).fill(0),
  sw: [{ cd: 0, tunnel: null }, { cd: 0, tunnel: null }],
  aim: null, planes: [], tracers: [], shells: [], booms: [], floats: [], scorch: [], smoke: [], wrecks: [],
  running: false, userPaused: false, speed: 1, uid: 1,
  shake: 0,
  offer: null,          /* card offer state machine (sim/cards.js) */
  reduceMotion: false,  /* UI sets this from matchMedia after boot */
};

export const fmt = x => String(Math.round(x * 10) / 10);
export const lineName = L => (L === 0 ? 'your HQ' : L === G.HQI ? 'the enemy HQ' : 'trench ' + L);
export const isDbl = L => G.DBL.indexOf(L) >= 0;
export const dblHeld = side => { let n = 0; for (const L of G.DBL) if (G.owner && G.owner[L] === side) n++; return n; };
export const depots = side => { let n = 0; for (const u of G.units) if (u.T.depot && u.side === side) n++; return n; };
export const incomeNow = () => G.M[0].income + G.M[0].growth * G.S.t / 60 + depots(0) * DEPOT_RATE + (G.owner && G.owner[G.SUPER] === 0 ? SUPER_INC : 0) + dblHeld(0) * DBL_RATE;
export const nestCost = side => utOf(G.nation[side], NAT[G.nation[side]].nest).cost;

export function setLayout(key) {
  const m = MAPS[key] || MAPS.open;
  G.LX.length = 0;
  if (m.belts) {
    const n = m.belts * m.per; let x = 150; G.LX.push(x);
    for (let i = 1; i <= n; i++) { x += i === 1 ? 230 : (((i - 1) % m.per) === 0 ? m.gap : m.tight); G.LX.push(x); }
    x += 230; G.LX.push(x); G.WW = x + 150; G.NT = n;
  } else {
    const n = m.n || 9; for (let i = 0; i <= n + 1; i++) G.LX.push(150 + i * 230); G.WW = G.LX[n + 1] + 150; G.NT = n;
  }
  G.HQI = G.NT + 1; G.SUPER = m.super ? Math.ceil(G.NT / 2) : -1; G.DBL = m.dbl || [];
}

export function mods() {
  const o = { dmg: {}, cd: {}, cost: {}, hp: 1, cover: 1, speed: 1, income: 3, growth: 0, bounty: 1, heal: 0, barrage: 0, tankHp: 1 };
  for (const k of ORDER.concat(['bunker', 'colossus', 'tsar', 'nest', 'pillbox', 'pit75', 'pit65', 'depot', 'char2c', 'carrier', 'guncarrier'])) { o.dmg[k] = 1; o.cd[k] = 1; o.cost[k] = 1; }
  return o;
}

export function applyTech() {
  const m = G.M[0];
  if (has('marks')) m.dmg.rifle *= 1.1;
  if (has('kit')) m.hp *= 1.1;
  if (has('craft')) m.speed *= 1.15;
  if (has('deep')) m.cover *= 0.92;
  if (has('walls')) { G.bases[0].max += 400; G.bases[0].hp += 400; }
  if (has('guns')) G.bases[0].dmg *= 1.4;
  if (has('aid')) m.heal += 1;
  if (has('stock')) G.S.supplies += 40;
  if (has('rail')) m.income += 0.4;
  if (has('econ')) m.bounty += 0.2;
  if (has('mech')) m.tankHp *= 1.1;
  if (has('gunnery')) { for (const k of TK) m.dmg[k] *= 1.1; m.dmg.mortar *= 1.1; }
  if (has('works')) for (const k of TK) m.cost[k] *= 0.9;
  if (has('titan')) G.S.unlocked.tkS = true;
}

/* Card relabelling per nation (prototype 1307–1320). Lives here, next to
 * G.nation, so sim/cards.js never needs to import state at module level. */
export function relabelCards() {
  for (const c of CARDS) { if (c.name0 === undefined) { c.name0 = c.name; c.text0 = c.text; } c.name = c.name0; c.text = c.text0; }
  const set = (id, name, text) => { const c = CARDS.find(x => x.id === id); if (name) c.name = name; c.text = text; };
  const r = utOf(G.nation[0], 'rifle'), cap = w => w[0].toUpperCase() + w.slice(1);
  set('draft', null, Math.round(80 / r.cost) + ' ' + r.pl + ' report to your HQ at once.');
  set('gunsec', null, '2 ' + utOf(G.nation[0], 'mg').pl + ' report to your HQ at once.');
  set('cheap', null, cap(r.pl) + ' cost 20% less.');
  set('musket', null, cap(r.pl) + ' and snipers deal 20% more damage.');
  const t = CARDTXT[G.nation[0]]; for (const id in t) set(id, t[id][0], t[id][1]);
  for (const [id, k, lab] of [['u_tkL', 'tkL', 'Light tank'], ['u_tkM', 'tkM', 'Medium-heavy tank'], ['u_tkH', 'tkH', 'Heavy tank'], ['u_tkS', 'tkS', 'Super-heavy tank']]) {
    const T = utOf(G.nation[0], k); if (!T) continue;
    set(id, (G.nation[0] === 'ah' ? 'Siege gun' : lab) + ': ' + T.name, 'Unlocks the ' + T.name + ': ' + T.role + ' It uses ' + fmt(T.w || 1) + ' of your ' + NAT[G.nation[0]].tanks + ' armour places.');
  }
}

/* sim→UI event shorthand used all over the port (prototype called toast()/refresh()/… directly) */
export const toast = msg => bus.emit('toast', msg);

/* Start a battle. Deterministic when `seed` is given (plan Task 6). */
export function newGame(mine, theirs, map, seed) {
  rng.reseed(seed);                       // undefined → random default seed
  G.nation = [mine, theirs]; G.MAP = MAPS[map] ? map : 'open'; setLayout(G.MAP); G.RIV = MAPS[G.MAP].rivers;
  G.S = { t: 0, score: 0, supplies: mine === 'aq' ? 15 : 40, kills: 0, losses: 0, cardKills: 0, need: 4, pending: 0, taken: {}, cards: 0, unlocked: { rifle: true, mg: true }, barrageT: 6, warnT: 0, superOwner: -1, superCard: false, superT: 0 };
  G.sw = [{ cd: 0, tunnel: null }, { cd: 0, tunnel: null }];
  G.M = [mods(), mods()];
  for (let s = 0; s < 2; s++) { if (G.nation[s] === 'gb') G.M[s].cd.rifle = 0.85; if (G.nation[s] === 'it') G.M[s].cover *= 0.85; }
  if (G.nation[0] === 'us') { G.M[0].income = 2.3; G.M[0].growth = 0.4; }
  if (G.nation[0] === 'aq') { G.M[0].income = 2; G.M[0].growth = 0.7; }
  relabelCards();
  G.units = []; G.aim = null; G.planes = []; G.tracers = []; G.shells = []; G.booms = []; G.floats = []; G.scorch = []; G.smoke = []; G.wrecks = [];
  G.bases = [{ x: G.LX[0], hp: BASE_HP, max: BASE_HP, cd: 0, dmg: 1 }, { x: G.LX[G.HQI], hp: BASE_HP, max: BASE_HP, cd: 0, dmg: 1 }];
  G.ai = { money: 40, buyT: 1, thinkT: 3, lastAdv: 0, aggr: 2, want: null, F: G.NT };
  G.fort = new Array(G.HQI + 1).fill(0); G.jobs = []; G.fields = []; G.garr = new Array(G.HQI + 1).fill(0);
  G.owner = new Array(G.HQI + 1).fill(-1); G.owner[0] = 0; G.owner[1] = 0; G.owner[G.NT] = 1; G.owner[G.HQI] = 1;
  G.sel = 1; G.offer = null;
  applyTech();
  for (let i = 0, n = Math.round((120 + (has('vets') ? 80 : 0)) / ut(0, 'rifle').cost); i < n; i++) spawn(0, 'rifle', 1, true);
  for (let i = 0, n = Math.round(AI_START * 20 / ut(1, 'rifle').cost); i < n; i++) spawn(1, 'rifle', G.NT, true);
  G.running = true; G.userPaused = false;
  bus.emit('game:start'); bus.emit('dirty:map'); bus.emit('dirty:buy'); bus.emit('hud');
  toast('Drag the field sideways to look around. Press Advance to take the next trench.');
}

