  sel=1;
  applyTech();
  for(let i=0,n=Math.round((120+(has('vets')?80:0))/ut(0,'rifle').cost);i<n;i++)spawn(0,'rifle',1,true);
  for(let i=0,n=Math.round(AI_START*20/ut(1,'rifle').cost);i<n;i++)spawn(1,'rifle',NT,true);
  cam=0;camT=0;running=true;userPaused=false;
  $('nmA').textContent=NAT[nation[0]].name+' (you)';$('nmB').textContent=NAT[nation[1]].name;
  $('pauseBtn').textContent='Pause';
  makeDecor();buildMap();buildBuy();refresh();
